{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "email:test": "node --test finds/email/*.test.ts",
    "email:typecheck": "tsc --noEmit -p finds/email/tsconfig.json",
    "email:dry-run": "node finds/email/dry-run.ts",
    "email:send": "node finds/email/send.ts",
    "sources:typecheck": "tsc --noEmit -p finds/sources/tsconfig.json",
    "sources:ingest:hn": "node finds/sources/run-hn.ts",
    "sources:ingest:uneed": "node finds/sources/run-uneed.ts",
    "sources:ingest:github": "node finds/sources/run-github.ts",
    "sources:ingest:peerlist": "node finds/sources/run-peerlist.ts",
    "comment:typecheck": "tsc --noEmit -p finds/comment/tsconfig.json",
    "comment:verify": "node finds/comment/verifyFidelity.ts",
    "comment:dry-run": "node finds/comment/dry-run.ts",
    "comment:post": "node finds/comment/postComment.ts",
    "score:test": "node --test finds/score/c1.test.ts finds/score/persist.test.ts finds/score/select.test.ts finds/score/c4.test.ts finds/score/c23.test.ts finds/score/score.test.ts finds/score/digest.test.ts",
    "score:typecheck": "tsc --noEmit -p finds/score/tsconfig.json",
    "score:prove-d7": "bash finds/score/prove-d7.sh",
    "verify:test": "node --test finds/verify/*.test.ts",
    "verify:typecheck": "tsc --noEmit -p finds/verify/tsconfig.json",
    "verify:crawl": "node finds/verify/cli.ts",
    "run:daily": "node finds/run/daily.ts",
    "run:typecheck": "tsc --noEmit -p finds/run/tsconfig.json",
    "run:test": "node --test finds/run/pipeline.test.ts",
    "run:prove": "bash finds/run/prove-daily.sh",
    "score:prove-pipeline": "bash finds/score/prove-pipeline.sh",
    "score:run": "node finds/score/run.ts",
    "verify:daily": "node finds/verify/daily.ts",
    "publish:test": "node --test finds/publish/snapshot.test.ts",
    "publish:typecheck": "tsc --noEmit -p finds/publish/tsconfig.json",
    "publish:prove": "bash finds/publish/prove-publish.sh",
    "publish:find": "node finds/publish/cli.ts",
    "prerender": "node scripts/prerender.mjs && node scripts/prerender-verify.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/vite": "^4.1.18",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemailer": "^9.0.6",
    "playwright": "1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
